---
import Badge from './Badge.astro';

const {
  title,
  subtitle,
  description,
  href,
  status,
  category,
  tags = []
} = Astro.props;

const borderClass = {
  iot: 'window-card-iot',
  ai: 'window-card-ai',
  prompting: 'window-card-prompting',
  security: 'window-card-security'
}[category] || 'window-card-iot';
---
<a
  href={href}
  class={`window-card surface rounded-2xl overflow-hidden shadow-card transition-transform duration-200 hover:-translate-y-1 ${borderClass}`}
  data-aos="fade-up"
>
  <div class="window-titlebar px-4 py-2">
    <div class="flex items-center gap-2">
      <span class="window-dot dot-red"></span>
      <span class="window-dot dot-yellow"></span>
      <span class="window-dot dot-green"></span>
      <span class="window-title ml-2">{title}</span>
    </div>
  </div>
  <div class="p-5">
    <div class="text-sm text-text-secondary">{subtitle}</div>
    <p class="mt-3 text-sm text-text-secondary">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {status && <Badge label={status} variant={status} />}
      {tags.map((tag) => (
        <span class="badge surface text-text-secondary">{tag}</span>
      ))}
    </div>
    <div class="mt-4 inline-flex items-center gap-2 text-xs uppercase tracking-[0.24em] text-text-secondary">
      Open
      <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
    </div>
  </div>
</a>
