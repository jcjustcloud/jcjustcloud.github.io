---
const { eyebrow, title, description } = Astro.props;
---
<div class="space-y-3">
  {eyebrow && (
    <div class="text-xs uppercase tracking-[0.35em] text-text-secondary">
      {eyebrow}
    </div>
  )}
  <h2 class="text-2xl sm:text-3xl font-display font-semibold">{title}</h2>
  {description && (
    <p class="text-text-secondary max-w-2xl">{description}</p>
  )}
</div>
