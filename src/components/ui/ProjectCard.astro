---
import Badge from './Badge.astro';

const {
  title,
  description,
  href,
  category = 'iot',
  status,
  tags = [],
  icon = 'sparkles'
} = Astro.props;

const categoryLabel = {
  iot: 'IoT',
  ai: 'AI Agent',
  prompting: 'Prompting',
  security: 'Security'
}[category];
---
<a
  href={href}
  class="surface rounded-2xl p-6 shadow-card transition-transform duration-200 hover:-translate-y-1"
  data-aos="fade-up"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="text-sm text-text-secondary">{categoryLabel}</div>
      <h3 class="text-lg font-display font-semibold mt-2">{title}</h3>
    </div>
    <div class="w-10 h-10 rounded-full bg-elevated flex items-center justify-center">
      <i data-lucide={icon} class="w-5 h-5"></i>
    </div>
  </div>
  <p class="text-text-secondary mt-3">{description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {categoryLabel && <Badge label={categoryLabel} variant={category} />}
    {status && <Badge label={status} variant={status} />}
    {tags.map((tag) => (
      <span class="badge surface text-text-secondary">{tag}</span>
    ))}
  </div>
</a>
