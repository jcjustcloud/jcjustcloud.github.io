<div class="theme-toggle" role="group" aria-label="Theme mode selector">
  <button
    type="button"
    class="theme-choice"
    data-theme-option="light"
    aria-label="Light theme"
  >
    Light
  </button>
  <button
    type="button"
    class="theme-choice"
    data-theme-option="dark"
    aria-label="Dark theme"
  >
    Dark
  </button>
  <button
    type="button"
    class="theme-choice"
    data-theme-option="dark-pink"
    aria-label="Dark pink theme"
  >
    Dark Pink
  </button>
</div>
