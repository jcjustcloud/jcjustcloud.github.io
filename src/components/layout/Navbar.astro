---
import ThemeToggle from './ThemeToggle.astro';
import { navLinks } from '../../data/nav';
---
<header
  class="sticky top-0 z-40 border-b border-border bg-base backdrop-blur"
  x-data="{ open: false }"
>
  <div class="max-w-6xl mx-auto px-6">
    <nav class="flex items-center justify-between py-4">
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="font-display text-lg font-semibold tracking-tight"
        >
          Awan
        </a>
        <span
          class="hidden sm:inline text-xs uppercase tracking-[0.2em] text-text-secondary"
        >
          Under the Cloud
        </span>
      </div>
      <div class="hidden lg:flex items-center gap-6 text-sm text-text-secondary">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="hover:text-accent transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <button
          class="lg:hidden border border-border rounded-full p-2 hover:border-accent transition"
          @click="open = !open"
          aria-label="Toggle menu"
          type="button"
        >
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
      </div>
    </nav>
    <div class="lg:hidden pb-4" x-show="open" x-cloak>
      <div class="surface rounded-2xl p-4 grid gap-3 text-sm">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="flex items-center justify-between hover:text-accent"
          >
            <span>{link.label}</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>
