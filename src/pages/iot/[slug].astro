---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const entries = await getCollection('iot');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const meta = [
  { label: entry.data.board, variant: 'iot' },
  { label: entry.data.status, variant: entry.data.status }
];

const details = [
  { label: 'Board', value: entry.data.board },
  { label: 'Status', value: entry.data.status },
  { label: 'Date', value: formatDate(entry.data.date) },
  { label: 'GitHub', value: 'Repository', href: entry.data.github }
];
---
<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  parentHref="/iot"
  parentLabel="IoT"
  meta={meta}
  details={details}
>
  <Content />
</ContentLayout>
