---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Timeline from '../../components/ui/Timeline.astro';
import Badge from '../../components/ui/Badge.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import WindowCard from '../../components/ui/WindowCard.astro';
import WindowGrid from '../../components/ui/WindowGrid.astro';

const deploymentSteps = [
  {
    title: 'Clone and configure',
    body: 'Pull the repo, set environment keys, and choose the agent targets.'
  },
  {
    title: 'Run locally or in CI',
    body: 'Use GitHub Actions or a local runner to execute tasks.'
  },
  {
    title: 'Review the markdown output',
    body: 'Summaries and evidence land in structured markdown files.'
  }
];

const demoOutput = `# AetherLab Run Summary

Target: home-lab.local
Mode: passive documentation
Findings:
- Host discovery completed
- Open services grouped by risk
- Follow-up checklist exported`;

const windows = [
  {
    title: 'Architecture',
    subtitle: 'Master Agent · 25 tools',
    description: 'Master flow, orchestrator role, and tool routing design.',
    href: '#architecture',
    status: 'active',
    category: 'ai',
    tags: ['LangGraph', 'CrewAI']
  },
  {
    title: 'Deployment',
    subtitle: 'Local · GitHub Actions',
    description: 'Runbook for local and cloud execution workflows.',
    href: '#deployment',
    status: 'active',
    category: 'ai',
    tags: ['CI/CD']
  },
  {
    title: 'Output',
    subtitle: 'Markdown · SQLite',
    description: 'Readable output format for review and archival.',
    href: '#output',
    status: 'active',
    category: 'ai',
    tags: ['Reports']
  }
];
---
<BaseLayout
  title="AI Agent - Awan"
  description="AetherLab: autonomous agents for practical security and research tasks."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10" data-aos="fade-up">
    <SectionHeader
      eyebrow="AetherLab"
      title="Autonomous agent, focused on practical outcomes"
      description="AetherLab is a master agent coordinating focused Kali tools for learning and monitoring."
    />
    <div class="mt-6 flex flex-wrap gap-2">
      <Badge label="Python" variant="ai" />
      <Badge label="LangGraph" variant="ai" />
      <Badge label="CrewAI" variant="ai" />
      <Badge label="SQLite" variant="ai" />
    </div>

    <div class="mt-8">
      <WindowGrid>
        {windows.map((window) => (
          <WindowCard {...window} />
        ))}
      </WindowGrid>
    </div>
  </section>

  <section id="architecture" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12" data-aos="fade-up">
    <div class="surface rounded-3xl p-6 shadow-card">
      <div class="text-xs uppercase tracking-[0.35em] text-text-secondary">
        Architecture
      </div>
      <h3 class="text-2xl font-display font-semibold mt-3">
        Master agent with a focused toolset
      </h3>
      <ul class="mt-4 space-y-2 text-text-secondary">
        <li>Master agent orchestrates 25 Kali security tools.</li>
        <li>Output stored in Markdown for review and sharing.</li>
        <li>SQLite keeps runs organized for quick recall.</li>
      </ul>
    </div>
  </section>

  <section id="deployment" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12" data-aos="fade-up">
    <SectionHeader
      eyebrow="Deploy"
      title="Run AetherLab anywhere"
      description="The workflow is designed to be simple and repeatable."
    />
    <div class="mt-8 surface rounded-3xl p-6 shadow-card">
      <Timeline items={deploymentSteps} />
    </div>
  </section>

  <section id="output" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12" data-aos="fade-up">
    <SectionHeader
      eyebrow="Demo"
      title="Markdown-first output"
      description="AetherLab favors readable notes over noisy dashboards."
    />
    <div class="mt-8 surface rounded-3xl p-6 shadow-card">
      <CodeBlock code={demoOutput} language="markdown" />
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20" data-aos="fade-up">
    <SectionHeader
      eyebrow="Stack"
      title="Tools and technologies"
      description="Focused on portability, automation, and clear output."
    />
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="surface rounded-2xl p-5">
        <div class="text-sm font-semibold">Core</div>
        <ul class="mt-3 space-y-2 text-sm text-text-secondary">
          <li>Python</li>
          <li>LangGraph and CrewAI</li>
          <li>Markdown reporting</li>
        </ul>
      </div>
      <div class="surface rounded-2xl p-5">
        <div class="text-sm font-semibold">Deployment</div>
        <ul class="mt-3 space-y-2 text-sm text-text-secondary">
          <li>GitHub Actions</li>
          <li>Local runs</li>
          <li>Cloud runner ready</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
