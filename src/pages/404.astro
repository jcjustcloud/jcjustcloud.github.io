---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="404 - Awan" description="Page not found.">
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-24 text-center" data-aos="fade-up">
    <div class="text-xs uppercase tracking-[0.35em] text-text-secondary">
      404
    </div>
    <h1 class="text-4xl font-display font-semibold mt-4">
      This page is still under the clouds
    </h1>
    <p class="text-text-secondary mt-4">
      The link is broken or the page was moved. Let us guide you back.
    </p>
    <div class="mt-8 flex justify-center">
      <Button label="Back to home" href="/" icon="arrow-left" />
    </div>
  </section>
</BaseLayout>
