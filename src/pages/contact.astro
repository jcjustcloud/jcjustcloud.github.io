---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ContactLinks from '../components/contact/ContactLinks.astro';
---
<BaseLayout
  title="Contact - Awan"
  description="Get in touch for collaboration or questions."
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-20" data-aos="fade-up">
    <SectionHeader
      eyebrow="Contact"
      title="Say hi"
      description="I respond on GitHub fastest."
    />
    <div class="mt-8">
      <ContactLinks />
    </div>
  </section>
</BaseLayout>
