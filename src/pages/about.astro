---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Badge from '../components/ui/Badge.astro';
import ContactLinks from '../components/contact/ContactLinks.astro';
import { skillGroups } from '../data/skills';
---
<BaseLayout
  title="About - Awan"
  description="Personal story, hardware stack, and the mindset behind the work."
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12" data-aos="fade-up">
    <SectionHeader
      eyebrow="About"
      title="Building with limited tools, growing with real work"
      description="Self taught tech enthusiast focused on shipping practical projects from a small home lab."
    />
    <div class="grid gap-8 lg:grid-cols-[1.1fr,0.9fr] mt-10">
      <div class="space-y-4 text-text-secondary">
        <p>
          My name is Muhammad Yusran Rizgullah, but most people call me Awan. I
          am a self taught builder, not from a formal engineering background. I
          learned by shipping real projects with whatever hardware I could
          afford.
        </p>
        <p>
          The goal is simple: build what matters. That means working in public,
          documenting the process, and keeping the tools humble and accessible.
        </p>
        <p>
          Under the cloud is my reminder to stay grounded. We are only creatures
          living beneath the sky, but we can still build things that help.
        </p>
      </div>
      <div class="surface rounded-3xl p-6 shadow-card space-y-6">
        <div class="flex items-center gap-4">
          <img
            src="/images/profile/awan-profile.svg"
            alt="Awan profile mark"
            class="w-20 h-20 rounded-2xl border border-border bg-base object-cover"
            loading="lazy"
            decoding="async"
          />
          <div>
            <div class="text-xs uppercase tracking-[0.3em] text-text-secondary">
              Muhammad Yusran Rizgullah
            </div>
            <div class="text-xl font-display font-semibold">Awan</div>
          </div>
        </div>
        <div class="text-xs uppercase tracking-[0.35em] text-text-secondary">
          Quick facts
        </div>
        <div class="grid gap-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Primary focus</span>
            <span class="font-semibold">IoT + AI Agents</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Home lab</span>
            <span class="font-semibold">Self built</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Learning style</span>
            <span class="font-semibold">Hands on</span>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <Badge label="Arduino Uno" variant="iot" />
          <Badge label="ESP32 v1" variant="iot" />
          <Badge label="ESP32 S3" variant="iot" />
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-12" data-aos="fade-up">
    <SectionHeader
      eyebrow="Stack"
      title="Hardware and software I touch daily"
      description="The essentials for building IoT systems and AI workflows."
    />
    <div class="grid gap-6 mt-8 md:grid-cols-3">
      {skillGroups.map((group) => (
        <div class="surface rounded-2xl p-5">
          <div class="text-sm font-semibold">{group.title}</div>
          <ul class="mt-3 space-y-2 text-sm text-text-secondary">
            {group.items.map((item) => (
              <li class="flex items-center gap-2">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16" data-aos="fade-up">
    <div class="surface rounded-3xl p-6 shadow-card">
      <div class="text-xs uppercase tracking-[0.35em] text-text-secondary">
        Philosophy
      </div>
      <h3 class="text-2xl font-display font-semibold mt-3">
        Under the cloud, building what matters
      </h3>
      <p class="text-text-secondary mt-3">
        No fancy lab, no expensive hardware. Just consistency, curiosity, and
        real output. Every project is a proof that limitations do not stop the
        work.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-20" data-aos="fade-up">
    <SectionHeader
      eyebrow="Contact"
      title="Find me online"
      description="Open for collaboration, questions, and shared learning."
    />
    <div class="mt-8">
      <ContactLinks />
    </div>
  </section>
</BaseLayout>
